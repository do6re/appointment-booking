{
  "name": "appointment-booking-backend",
  "version": "1.0.0",
  "description": "Backend for appointment booking system",
  "main": "src/index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "db:migrate": "ts-node src/migrations/migrate.ts",
    "db:seed": "ts-node src/migrations/seed.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "pg": "^8.9.0",
    "uuid": "^9.0.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.1",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^18.15.11",
    "@types/uuid": "^9.0.2",
    "typescript": "^5.0.2",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.1",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.38.0"
